#!/usr/bin/env python3
"""Weaken every marked GR-06 guard; require a test failure and green restoration.

Mutants run sequentially in this checkout. The dedicated GR-06 suite covers
these guards; the full regression suite is required before and after the batch.
An import/collection failure is an invalid mutant, never counted as a kill.
"""
import argparse
import ast
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--only', nargs='+')
parser.add_argument('--resume', action='store_true', help='skip unchanged guards already killed with a green restoration')
args = parser.parse_args()
selected = set(args.only) if args.only else None
output = ROOT / '.evidence/gr06'
output.mkdir(parents=True, exist_ok=True)
manifest = output/'mutations.json'
results = json.loads(manifest.read_text()) if manifest.exists() and (args.only or args.resume) else []
for path in sorted((ROOT / 'src/gruntime').rglob('*.py')):
    original = path.read_text()
    lines = original.splitlines(keepends=True)
    tree = ast.parse(original)
    for number, line in enumerate(lines, 1):
        match = re.search(r'# guard:(gr06_[a-z_]+)', line)
        if not match or selected is not None and match[1] not in selected:
            continue
        name = match[1]
        nodes = [n for n in ast.walk(tree) if isinstance(n, ast.stmt) and n.lineno == number]
        if not nodes:
            raise RuntimeError(f'guard without statement: {name}')
        node = min(nodes, key=lambda n: n.end_lineno - n.lineno)
        fingerprint = hashlib.sha256(''.join(lines[node.lineno-1:node.end_lineno]).encode()).hexdigest()
        if args.resume and any(r['guard'] == name and r['guard_sha256'] == fingerprint and r['killed'] and r['restored'] for r in results):
            continue
        if isinstance(node, ast.If):
            # Preserve the branch structure and disable this particular gate.
            start, end = node.test.lineno, node.test.end_lineno
            prefix = lines[start-1][:node.test.col_offset]
            suffix = lines[end-1][node.test.end_col_offset:]
            condition = 'True' if name in ('gr06_human_grantor', 'gr06_policy_grantor', 'gr06_role_grantor') else 'False'
            replacement = prefix + condition + suffix
        else:
            start, end = node.lineno, node.end_lineno
            indent = lines[start-1][:node.col_offset]
            replacement = indent + ('return True' if isinstance(node, ast.Return) else 'pass') + '\n'
        mutant = ''.join(lines[:start-1]) + replacement + ''.join(lines[end:])
        ast.parse(mutant)
        print(f'Checking {name}', flush=True)
        with tempfile.TemporaryDirectory(prefix='gr06-mutation-') as cache:
            env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTHONPYCACHEPREFIX=cache)
            cmd = [str(ROOT/'.venv/bin/python'), '-B', '-m', 'pytest', '-q', '-ra', '--color=no', '-p', 'no:cacheprovider', 'tests/test_gr06_contract_authority.py']
            try:
                path.write_text(mutant)
                run = subprocess.run(cmd + ['--maxfail=1'], cwd=ROOT, env=env, capture_output=True, text=True)
            finally:
                path.write_text(original)
            restored = subprocess.run(cmd, cwd=ROOT, env=env, capture_output=True, text=True)
        (output/f'{name}-mutant.log').write_text(run.stdout+run.stderr)
        (output/f'{name}-restored.log').write_text(restored.stdout+restored.stderr)
        failures = [line for line in run.stdout.splitlines() if line.startswith('FAILED ')]
        valid = run.returncode == 1 and bool(failures) and 'ERROR collecting' not in run.stdout
        passed = valid and restored.returncode == 0
        results = [r for r in results if r['guard'] != name]
        results.append(dict(guard=name, file=str(path.relative_to(ROOT)), line=number,
            guard_sha256=fingerprint,
            killed=valid, restored=restored.returncode == 0, failures=failures,
            mutant_summary=run.stdout.strip().splitlines()[-1], restored_summary=restored.stdout.strip().splitlines()[-1]))
        (output/'mutations.json').write_text(json.dumps(results, indent=2)+'\n')
        print(f'  {results[-1]["mutant_summary"]}; restored: {restored.returncode}', flush=True)
        if not passed:
            print(f'Failed mutation check: {name}. Original source restored.', flush=True)
            sys.exit(1)
print(f'All {len(results)} guards killed; all restored GR-06 suites passed.', flush=True)
