#!/usr/bin/env python3
"""Weaken every marked GR-08 guard; require a test failure and green restoration.

Mutants run sequentially in this checkout. The dedicated GR-08 suite covers
these guards; the full regression suite is required before and after the batch.
An import/collection failure is an invalid mutant, never counted as a kill.
"""
import argparse
import ast
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


SELECTORS = {'gr08_artifact_write': 'checks_run_before_sink_write',
 'gr08_bridge_leak_failure': 'secret_never_reaches and progress',
 'gr08_credential_header': 'relay_configuration_guards',
 'gr08_credential_value': 'relay_configuration_guards',
 'gr08_event_append': 'checks_run_before_sink_write',
 'gr08_fake_write': 'log_and_fake_output',
 'gr08_fingerprint_write': 'secret_name_and_fingerprint',
 'gr08_header_injection': 'request_guards_precede_transport',
 'gr08_http_deadline': 'http_boundary_guards',
 'gr08_http_delivery': 'http_boundary_guards',
 'gr08_http_framing': 'http_boundary_guards',
 'gr08_http_limit': 'http_boundary_guards',
 'gr08_https': 'destination_parser',
 'gr08_local_target': 'bridge_network_guards',
 'gr08_log_line': 'log_and_fake_output',
 'gr08_method': 'request_guards_precede_transport',
 'gr08_network_grant': 'bridge_network_guards',
 'gr08_network_live': 'bridge_network_guards',
 'gr08_origin_config': 'relay_configuration_guards',
 'gr08_origin_request': 'request_guards_precede_transport',
 'gr08_outbound_headers': 'https_relay_injects',
 'gr08_port': 'destination_parser',
 'gr08_process_deadline': 'worker_transport_guards',
 'gr08_process_input': 'worker_transport_guards',
 'gr08_process_kill': 'worker_transport_guards',
 'gr08_process_output': 'worker_transport_guards',
 'gr08_process_output_limit': 'worker_transport_guards',
 'gr08_progress': 'checks_run_before_sink_write',
 'gr08_protocol_headers': 'relay_configuration_guards',
 'gr08_provider_diagnostic': 'secret_never_reaches and exception',
 'gr08_provider_input': 'provider_input_is_checked',
 'gr08_provider_output': 'secret_never_reaches and stderr',
 'gr08_receipt_check': 'receipt_boundary',
 'gr08_redirect': 'redirects_are_refused and 302 and other',
 'gr08_relay_binding': 'bridge_network_guards',
 'gr08_relay_deadline': 'relay_authorization_and_deadline',
 'gr08_request_authority': 'relay_authorization_and_deadline',
 'gr08_request_limit': 'request_guards_precede_transport',
 'gr08_request_secret': 'request_guards_precede_transport',
 'gr08_request_target': 'request_guards_precede_transport',
 'gr08_request_types': 'request_guards_precede_transport',
 'gr08_response_limit': 'relay_response_guards',
 'gr08_response_secret': 'relay_response_guards',
 'gr08_schema_write': 'worker_transport_guards',
 'gr08_secret_approval': 'secret_resolution_authority_guards',
 'gr08_secret_currency': 'secret_resolution_authority_guards',
 'gr08_secret_grant': 'secret_resolution_authority_guards',
 'gr08_secret_integrity': 'secret_resolution_authority_guards',
 'gr08_secret_match': 'salted_checker',
 'gr08_secret_name': 'secret_name_and_fingerprint',
 'gr08_secret_nonce': 'secret_resolution_authority_guards',
 'gr08_single_origin': 'secret_resolution_authority_guards',
 'gr08_sql_many': 'checks_run_before_sink_write',
 'gr08_sql_script': 'checks_run_before_sink_write',
 'gr08_sql_write': 'checks_run_before_sink_write',
 'gr08_tls_verification': 'relay_response_guards',
 'gr08_tool_diagnostic': 'tool_secret_diagnostics',
 'gr08_tool_metadata': 'tool_secret_diagnostics',
 'gr08_url_syntax': 'destination_parser',
 'gr08_worker_diagnostic': 'controller_diagnostic',
 'gr08_worker_environment': 'real_worker_uses_bridge',
 'gr08_worker_isolation': 'real_worker_uses_bridge',
 'gr08_worker_only': 'worker_only_transport',
 'gr08_worker_output': 'controller_worker_output'}

SELECTORS.update({
    'gr08_nonempty_secret': 'empty_secret',
    'gr08_cursor_write': 'cursor_sinks and execute',
    'gr08_cursor_many': 'cursor_sinks and executemany',
    'gr08_cursor_script': 'cursor_sinks and executescript',
    'gr08_shim_framing': 'shim_framing_guard',
    'gr08_relay_watchdog': 'watchdog_interrupts',
    'gr08_before_send': 'deadline_and_authority_after_connect and authorization',
    'gr08_send_deadline': 'deadline_and_authority_after_connect and send-deadline',
    'gr08_response_deadline': 'deadline_and_authority_after_connect and response-deadline',
    'gr08_worker_lease': 'worker_lease_limits',
})

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--only', nargs='+')
parser.add_argument('--resume', action='store_true', help='skip unchanged guards already killed with a green restoration')
args = parser.parse_args()
selected = set(args.only) if args.only else None
output = ROOT / '.evidence/gr08'
output.mkdir(parents=True, exist_ok=True)
manifest = output/'mutations.json'
results = json.loads(manifest.read_text()) if manifest.exists() and (args.only or args.resume) else []
for path in sorted((ROOT / 'src/gruntime').rglob('*.py')):
    original = path.read_text()
    lines = original.splitlines(keepends=True)
    tree = ast.parse(original)
    for number, line in enumerate(lines, 1):
        match = re.search(r'# guard:(gr08_[a-z_]+)', line)
        if not match or selected is not None and match[1] not in selected:
            continue
        name = match[1]
        nodes = [n for n in ast.walk(tree) if isinstance(n, ast.stmt) and n.lineno <= number <= n.end_lineno]
        if not nodes:
            raise RuntimeError(f'guard without statement: {name}')
        node = min(nodes, key=lambda n: n.end_lineno - n.lineno)
        fingerprint = hashlib.sha256(''.join(lines[node.lineno-1:node.end_lineno]).encode()).hexdigest()
        if args.resume and any(r['guard'] == name and r['guard_sha256'] == fingerprint and r['killed'] and r['restored'] for r in results):
            continue
        if isinstance(node, ast.If):
            # Preserve the branch structure and disable this particular gate.
            start, end = node.test.lineno, node.test.end_lineno
            prefix = lines[start-1][:node.test.col_offset]
            suffix = lines[end-1][node.test.end_col_offset:]
            condition = 'False'
            replacement = prefix + condition + suffix
        elif name == 'gr08_worker_isolation':
            start, end = node.lineno, node.end_lineno
            replacement = lines[start-1].replace("'--unshare-all', ", '')
        elif name == 'gr08_worker_environment':
            start, end = node.lineno, node.end_lineno
            replacement = ''.join(lines[start-1:end]).replace("'--clearenv',", '').replace("'--setenv', 'HOME', '/home/worker',", '')
        elif name == 'gr08_tls_verification':
            start, end = node.lineno, node.end_lineno
            replacement = lines[start-1].replace('ssl.create_default_context', 'ssl._create_unverified_context')
        elif name == 'gr08_outbound_headers':
            start, end = node.lineno, node.end_lineno
            replacement = ' ' * node.col_offset + "headers = dict(args['headers'])\n"
        elif name == 'gr08_worker_lease':
            start, end = node.lineno, node.end_lineno
            replacement = ' ' * node.col_offset + 'lease_deadline = request.deadline_at\n'
        else:
            start, end = node.lineno, node.end_lineno
            indent = lines[start-1][:node.col_offset]
            replacement = indent + ('return True' if isinstance(node, ast.Return) else 'pass') + '\n'
        mutant = ''.join(lines[:start-1]) + replacement + ''.join(lines[end:])
        ast.parse(mutant)
        print(f'Checking {name}', flush=True)
        with tempfile.TemporaryDirectory(prefix='gr08-mutation-') as cache:
            env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTHONPYCACHEPREFIX=cache)
            cmd = [str(ROOT/'.venv/bin/python'), '-B', '-m', 'pytest', '-q', '-ra', '--color=no', '-p', 'no:cacheprovider', 'tests/test_gr08_inference_relay.py', 'tests/test_gr08_relay_boundaries.py']
            selector = SELECTORS.get(name)
            if selector:
                cmd += ['-k', selector]
            try:
                path.write_text(mutant)
                run = subprocess.run(cmd + ['--maxfail=1'], cwd=ROOT, env=env, capture_output=True, text=True, timeout=90)
            finally:
                path.write_text(original)
            restored = subprocess.run(cmd, cwd=ROOT, env=env, capture_output=True, text=True, timeout=90)
        (output/f'{name}-mutant.log').write_text(run.stdout+run.stderr)
        (output/f'{name}-restored.log').write_text(restored.stdout+restored.stderr)
        failures = [line for line in run.stdout.splitlines() if line.startswith('FAILED ')]
        valid = run.returncode == 1 and bool(failures) and 'ERROR collecting' not in run.stdout
        passed = valid and restored.returncode == 0
        results = [r for r in results if r['guard'] != name]
        results.append(dict(guard=name, file=str(path.relative_to(ROOT)), line=number,
            guard_sha256=fingerprint,
            killed=valid, restored=restored.returncode == 0, failures=failures,
            mutant_summary=run.stdout.strip().splitlines()[-1], restored_summary=restored.stdout.strip().splitlines()[-1]))
        (output/'mutations.json').write_text(json.dumps(results, indent=2)+'\n')
        print(f'  {results[-1]["mutant_summary"]}; restored: {restored.returncode}', flush=True)
        if not passed:
            print(f'Failed mutation check: {name}. Original source restored.', flush=True)
            sys.exit(1)
print(f'All {len(results)} guards killed; all restored GR-08 suites passed.', flush=True)
