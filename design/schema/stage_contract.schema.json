{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.governed-runtime/design-01/stage_contract.schema.json",
  "title": "StageContract",
  "description": "Frozen, hash-pinned statement of what a stage run is authorized to attempt and what would count as satisfying it. Vendor-neutral: contains no provider, model, or host-project identifiers.",
  "type": "object",

  "$comment": "HASHING: contract_hash = '<alg>:' + lowerhex(alg(JCS(self_without_hash))) where (1) self_without_hash is this object with the member 'contract_hash' removed and nothing else changed; (2) JCS is RFC 8785 JSON Canonicalization Scheme applied to the remaining object, covering every other member defined by this schema, including optional members that are present and excluding members that are absent; (3) alg is the algorithm named by the prefix of contract_hash itself, restricted to 'sha256'. Absent optional members are not defaulted before hashing. Recomputation MUST equal the stored value at activation and at every later verification; inequality is an INTEGRITY_VIOLATION, not a validation error.",

  "properties": {
    "schema_version": {
      "$comment": "Version of this schema the document was authored against.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contract_id":      { "$ref": "#/$defs/Ulid" },
    "stage_id":         { "$ref": "#/$defs/Ulid" },
    "project_id":       { "$ref": "#/$defs/Ulid" },
    "contract_version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "supersedes":       { "oneOf": [ { "$ref": "#/$defs/Ulid" }, { "type": "null" } ] },

    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "REVOKED", "EXPIRED", "FULFILLED"]
    },

    "objective": { "type": "string", "minLength": 1, "maxLength": 8192 },

    "scope_include": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Glob" }
    },
    "scope_exclude": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Glob" }
    },

    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/AcceptanceCriterion" }
    },
    "required_validations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/ValidationSpec" }
    },
    "required_reviews": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/ReviewSpec" }
    },

    "prohibited_actions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },

    "capability_request": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/CapabilityId" }
    },

    "worker_role": {
      "type": "string",
      "enum": ["PLANNER", "IMPLEMENTER", "REVIEWER", "INTEGRATOR", "ANALYST"]
    },

    "budget_ceiling": { "$ref": "#/$defs/Budget" },

    "deadline_ms": { "type": "integer", "minimum": 1000, "maximum": 604800000 },

    "escalation_triggers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/EscalationTrigger" }
    },

    "rollback_policy": {
      "type": "string",
      "enum": ["NONE", "REVERT_COMMITS", "RESTORE_SNAPSHOT"]
    },

    "evidence_retention_class": {
      "type": "string",
      "enum": ["PERMANENT", "STANDARD", "EPHEMERAL"]
    },

    "authored_by": { "$ref": "#/$defs/ActorRef" },
    "authored_at": { "$ref": "#/$defs/Timestamp" },

    "contract_hash": {
      "$comment": "Excluded from its own preimage. See the top-level HASHING comment.",
      "$ref": "#/$defs/Hash"
    }
  },

  "required": [
    "schema_version",
    "contract_id",
    "stage_id",
    "project_id",
    "contract_version",
    "status",
    "objective",
    "scope_include",
    "scope_exclude",
    "acceptance_criteria",
    "required_validations",
    "required_reviews",
    "prohibited_actions",
    "capability_request",
    "worker_role",
    "budget_ceiling",
    "deadline_ms",
    "escalation_triggers",
    "rollback_policy",
    "evidence_retention_class",
    "authored_by",
    "authored_at",
    "contract_hash"
  ],

  "unevaluatedProperties": false,

  "allOf": [
    {
      "$comment": "RC-1: a REVIEWER contract may not request workspace-mutating capabilities.",
      "if": {
        "properties": { "worker_role": { "const": "REVIEWER" } },
        "required": ["worker_role"]
      },
      "then": {
        "properties": {
          "capability_request": {
            "items": { "not": { "enum": ["fs.write", "fs.delete", "commit.propose"] } }
          }
        }
      }
    },
    {
      "$comment": "RC-3: a PLANNER contract may not request workspace-mutating or execution capabilities.",
      "if": {
        "properties": { "worker_role": { "const": "PLANNER" } },
        "required": ["worker_role"]
      },
      "then": {
        "properties": {
          "capability_request": {
            "items": {
              "not": {
                "enum": ["fs.write", "fs.delete", "commit.propose", "proc.exec.validation"]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "A JUDGMENTAL criterion is unverifiable without at least one ReviewSpec.",
      "if": {
        "properties": {
          "acceptance_criteria": {
            "contains": {
              "properties": { "kind": { "const": "JUDGMENTAL" } },
              "required": ["kind"]
            }
          }
        },
        "required": ["acceptance_criteria"]
      },
      "then": { "properties": { "required_reviews": { "minItems": 1 } } }
    },
    {
      "$comment": "A MECHANICAL criterion is unverifiable without at least one ValidationSpec.",
      "if": {
        "properties": {
          "acceptance_criteria": {
            "contains": {
              "properties": { "kind": { "const": "MECHANICAL" } },
              "required": ["kind"]
            }
          }
        },
        "required": ["acceptance_criteria"]
      },
      "then": { "properties": { "required_validations": { "minItems": 1 } } }
    }
  ],

  "$defs": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },

    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },

    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },

    "SpecId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },

    "RelPath": {
      "$comment": "Workspace-relative POSIX path. No leading slash, no '.' or '..' segment, no backslash. Control characters are rejected at authoring time (XC-14).",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\\\]+$"
    },

    "Glob": {
      "$comment": "POSIX glob over a workspace-relative path. Same containment rules as RelPath; a single '.' segment is permitted so that '.' cannot be spelled but './*' style roots are still rejected.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
    },

    "CapabilityId": {
      "$comment": "Registry key from authority-matrix.md section 2. KERNEL-class and NEVER-class ids are rejected at activation (XC-8), not here.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
    },

    "EscalationTrigger": {
      "type": "string",
      "enum": [
        "CONTRACT_AMBIGUITY",
        "CAPABILITY_DENIED",
        "SCOPE_BREACH_ATTEMPT",
        "BUDGET_EXHAUSTED",
        "DEADLINE_EXCEEDED",
        "REPEATED_FAILURE",
        "VALIDATION_UNAVAILABLE",
        "NONDETERMINISM",
        "BLOCKER_FINDING",
        "DECLARED_OBSERVED_CONFLICT",
        "REALITY_DRIFT",
        "ROADMAP_DIVERGED",
        "POLICY_CONFLICT",
        "INTEGRITY_VIOLATION"
      ]
    },

    "ActorRef": {
      "type": "object",
      "properties": {
        "actor_kind": {
          "type": "string",
          "enum": ["HUMAN", "WORKER", "RUNTIME", "ADAPTER", "EXTERNAL"]
        },
        "actor_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "principal_key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "auth_method": {
          "type": "string",
          "enum": ["NONE", "SESSION", "SIGNATURE", "MTLS", "DELEGATED"]
        }
      },
      "required": ["actor_kind", "actor_id", "auth_method"],
      "allOf": [
        {
          "$comment": "HD-INV-1: a HUMAN actor must be authenticated and key-identified.",
          "if": {
            "properties": { "actor_kind": { "const": "HUMAN" } },
            "required": ["actor_kind"]
          },
          "then": {
            "required": ["principal_key_id"],
            "properties": {
              "auth_method": { "enum": ["SESSION", "SIGNATURE", "MTLS"] }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },

    "Budget": {
      "type": "object",
      "properties": {
        "wall_clock_ms":         { "type": "integer", "minimum": 0 },
        "worker_invocations":    { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "cost_units":            { "type": "integer", "minimum": 0 },
        "validation_executions": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "commits":               { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "escalations":           { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "required": [
        "wall_clock_ms",
        "worker_invocations",
        "cost_units",
        "validation_executions",
        "commits",
        "escalations"
      ],
      "unevaluatedProperties": false
    },

    "CommandSpec": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "cwd": { "$ref": "#/$defs/RelPath" },
        "env_allowlist": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" }
        },
        "network": { "type": "string", "enum": ["NONE", "ALLOWLIST", "ANY"] },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "stdin_digest": { "oneOf": [ { "$ref": "#/$defs/Hash" }, { "type": "null" } ] }
      },
      "required": ["argv", "cwd", "env_allowlist", "network", "timeout_ms"],
      "unevaluatedProperties": false
    },

    "AcceptanceCriterion": {
      "type": "object",
      "properties": {
        "criterion_id": { "$ref": "#/$defs/SpecId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "kind": { "type": "string", "enum": ["MECHANICAL", "JUDGMENTAL"] },
        "verifier_ref": { "$ref": "#/$defs/SpecId" },
        "mandatory": { "type": "boolean" },
        "waivable": { "type": "boolean" }
      },
      "required": ["criterion_id", "text", "kind", "verifier_ref", "mandatory", "waivable"],
      "unevaluatedProperties": false
    },

    "ValidationSpec": {
      "type": "object",
      "properties": {
        "spec_id": { "$ref": "#/$defs/SpecId" },
        "command": { "$ref": "#/$defs/CommandSpec" },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": -128, "maximum": 255 }
        },
        "determinism_class": {
          "type": "string",
          "enum": ["DETERMINISTIC", "FLAKY_TOLERANT", "NONDETERMINISTIC"]
        },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 16 },
        "result_parser": {
          "type": "string",
          "enum": ["EXIT_CODE", "JSON_REPORT", "JUNIT_XML", "NONE"]
        }
      },
      "required": [
        "spec_id",
        "command",
        "expected_exit_codes",
        "determinism_class",
        "max_retries",
        "result_parser"
      ],
      "allOf": [
        {
          "$comment": "A DETERMINISTIC validator may not retry and may not use unrestricted network; otherwise its replay_key carries no meaning.",
          "if": {
            "properties": { "determinism_class": { "const": "DETERMINISTIC" } },
            "required": ["determinism_class"]
          },
          "then": {
            "properties": {
              "max_retries": { "const": 0 },
              "command": {
                "properties": { "network": { "enum": ["NONE", "ALLOWLIST"] } }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },

    "ReviewSpec": {
      "type": "object",
      "properties": {
        "spec_id": { "$ref": "#/$defs/SpecId" },
        "reviewer_kind": { "type": "string", "enum": ["AUTOMATED", "PEER_WORKER", "HUMAN"] },
        "independence_required": {
          "type": "string",
          "enum": ["INDEPENDENT", "SHARED_CONTEXT_ALLOWED"]
        },
        "blocking_severity": { "type": "string", "enum": ["BLOCKER", "MAJOR", "MINOR"] },
        "quorum": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "required": [
        "spec_id",
        "reviewer_kind",
        "independence_required",
        "blocking_severity",
        "quorum"
      ],
      "unevaluatedProperties": false
    }
  },

  "x-constraints-not-expressible-here": [
    {
      "id": "XC-1",
      "rule": "acceptance_criteria[*].criterion_id is unique within the contract",
      "enforced_at": "contract.author"
    },
    {
      "id": "XC-2",
      "rule": "required_validations[*].spec_id and required_reviews[*].spec_id are each unique, and the two sets are disjoint",
      "enforced_at": "contract.author"
    },
    {
      "id": "XC-3",
      "rule": "every acceptance_criteria entry with kind=MECHANICAL has verifier_ref resolving to a required_validations[*].spec_id",
      "enforced_at": "contract.author"
    },
    {
      "id": "XC-4",
      "rule": "every acceptance_criteria entry with kind=JUDGMENTAL has verifier_ref resolving to a required_reviews[*].spec_id",
      "enforced_at": "contract.author"
    },
    {
      "id": "XC-5",
      "rule": "at least one acceptance_criteria entry has mandatory=true",
      "enforced_at": "contract.author"
    },
    {
      "id": "XC-6",
      "rule": "required_validations[*].command.cwd matches scope_include and does not match scope_exclude",
      "enforced_at": "contract.activate"
    },
    {
      "id": "XC-7",
      "rule": "required_validations[*].command.timeout_ms does not exceed deadline_ms",
      "enforced_at": "contract.activate"
    },
    {
      "id": "XC-8",
      "rule": "capability_request is a subset of project.capability_ceiling and contains no KERNEL-class or NEVER-class capability",
      "enforced_at": "contract.activate"
    },
    {
      "id": "XC-9",
      "rule": "command.network=ANY requires net.egress.any in capability_request; command.network=ALLOWLIST requires net.egress.allowlist",
      "enforced_at": "contract.activate"
    },
    {
      "id": "XC-10",
      "rule": "budget_ceiling does not exceed the project's remaining budget on any dimension",
      "enforced_at": "contract.activate"
    },
    {
      "id": "XC-11",
      "rule": "supersedes, when non-null, refers to a StageContract with the same stage_id and a lower contract_version",
      "enforced_at": "contract.supersede"
    },
    {
      "id": "XC-12",
      "rule": "contract_hash recomputes over JCS of this document minus the contract_hash member; mismatch is INTEGRITY_VIOLATION",
      "enforced_at": "contract.activate and every later verification"
    },
    {
      "id": "XC-13",
      "rule": "no member other than status differs between any two persisted documents sharing a contract_id",
      "enforced_at": "persistence layer"
    },
    {
      "id": "XC-14",
      "rule": "no string member contains a Unicode control character (U+0000 to U+001F, U+007F)",
      "enforced_at": "contract.author"
    }
  ]
}
